// Cloudflare Workers 只读 demo 部署配置
// 部署：npm run demo:deploy（构建前端后 npx wrangler deploy）
{
  "name": "yasubman-demo",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-01-01",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
